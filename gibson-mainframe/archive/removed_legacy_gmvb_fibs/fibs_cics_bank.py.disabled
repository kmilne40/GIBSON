    lines = _header('BKGMENU') + [
        _pad(''),
        _pad('                                                   S I G H B E R B A N K  P L C'),
        _pad('                                             BANKMASTER/VS - MAIN TRANSACTION MENU'),
        _pad('                                             ----------------------------------------'),
        _pad(''),
        _pad('          1 CUST - CUSTOMER MASTER MAINTENANCE'),
        _pad('          2 ACCT - ACCOUNT INQUIRY & MAINTENANCE'),
        _pad('          3 TRAN - TRANSACTION POSTING'),
        _pad('          4 BULK - BULK PROCESSING CENTRE  (MORTGAGE / PAYMENTS / CARD APPROVALS)'),
        _pad('          ----------------------------------------------------------------'),
        _pad('          6 REST - REST API SECURITY TESTER [SECURITY LAB]'),
        _pad('          7 TN32 - TN3270 PACKET ANALYSER (PLAINTEXT STREAM)'),
        _pad('          ----------------------------------------------------------------'),
        _pad('          CECI - COMMAND INTERPRETER ⚠ NO AUTH (VULN #6)'),
        _pad('          CEMT - MASTER TERMINAL ⚠ NO AUTH (VULN #5)'),
        _pad('          8 CICS - CICS TRANSACTION SERVICES (CEDA/CEDF/BMS/SECURITY LAB)'),
        _pad('          9 BLAB - BANKING LAB (INTERACTIVE VULNERABILITY SIMULATION)'),
        _pad('          DVCA - DAMN VULNERABLE CICS APPLICATION ⚠ FIBS/HACK3270 TRAINING'),
        _pad('          5 LOGO - SIGN OFF TERMINAL'),
        _pad('          ----------------------------------------------------------------'),
        _pad('          TYPE LOGON APPLID(CICS) TO ACCESS CICS APPLID DIRECTLY'),
        _pad(f'OPERATOR: {u:<8} TERMINAL: {sess.terminal} REGION: {sess.region} DATE: {_today()}'),
        _pad(f'SELECTION ==>                                      OR TYPE TRANSACTION CODE DIRECTLY'),
        _pad(f'TRANS: MENU     OPER: {u:<8}                         SIGNON OK - {u}'),
        _pad('PF1=HELP PF3=SIGNOFF PF12=CODE'),
    ]
    return _screen('MENU', 'BANKMASTER/VS MAIN TRANSACTION MENU', lines, [
        _field('selection', 'SELECTION', 25, 16, 16, ''),
    ], sess.message)


def _sql_rows(state: Any, sql: str, userid: str = 'IBMUSER') -> list[dict[str, Any]]:
    try:
        return [dict(r) for r in Db2Simulator(state).run_sql(sql, userid)]
    except Exception:
        return []


def _db2_audit(state: Any, sess: FibsCicsSession, action: str, details: str) -> None:
    user = sess.userid or 'ANON'
    esc_details = str(details).replace("'", "''")[:180]
    esc_action = str(action).replace("'", "''")[:40]
    sql = ("INSERT INTO FIBS.AUDITLOG "
           "(EVENT_TYPE,ACTION,RESULT,RESOURCE,DETAILS,SOURCE) "
           f"VALUES ('CICS','{esc_action}','OK','FIBS','{esc_details}','cics')")
    try:
        Db2Simulator(state).run_sql(sql, user)
    except Exception:
        pass


def _customer_screen(state: Any, sess: FibsCicsSession, q: str = '') -> dict[str, Any]:
    rows = _sql_rows(state, "SELECT * FROM FIBS.CUSTOMER", sess.userid or 'IBMUSER')
    q = q or sess.fields.get('customer_id') or (rows[0].get('CUSTOMER_ID') if rows else '10000001')
    rec = next((r for r in rows if str(r.get('CUSTOMER_ID')) == str(q)), rows[0] if rows else {})
    lines = _header('CUST') + [
        _pad('                         CUSTOMER MASTER MAINTENANCE'),
        _pad(''),
        _pad(f' CUSTOMER ID . . . . {q}'),
        _pad(f' FORENAME . . . . . . {rec.get("FORENAME", rec.get("FIRST_NAME", "JANE"))}'),
        _pad(f' SURNAME . . . . . . . {rec.get("SURNAME", rec.get("LAST_NAME", "CUSTOMER"))}'),
        _pad(f' ADDRESS . . . . . . . {rec.get("ADDRESS_LINE_1", rec.get("ADDRESS", "1 HIGH STREET"))}'),
        _pad(f' TOWN . . . . . . . . . {rec.get("TOWN", "LONDON")}'),
        _pad(f' STATUS . . . . . . . . {rec.get("STATUS", "ACTIVE")}'),
        _pad(''),
        _pad(' ACTIONS: INQ ADD UPD DEL   PF3=MENU PF5=ADD PF8=INQUIRE'),
        _pad(' DB2 TABLE: FIBS.CUSTOMER / CICS PROGRAM: FIBSCUST'),
    ]
    return _screen('CUST', 'CUSTOMER MASTER MAINTENANCE', lines, [
        _field('customer_id', 'CUSTOMER ID', 5, 24, 12, q),
        _field('forename', 'FORENAME', 6, 24, 20, rec.get('FORENAME', '')),
        _field('surname', 'SURNAME', 7, 24, 20, rec.get('SURNAME', '')),
        _field('cust_action', 'ACTION', 15, 10, 6, 'INQ'),
    ], sess.message)


def _account_screen(state: Any, sess: FibsCicsSession, q: str = '') -> dict[str, Any]:
    rows = _sql_rows(state, "SELECT * FROM FIBS.ACCOUNT", sess.userid or 'IBMUSER')
    q = q or sess.fields.get('account') or (rows[0].get('ACCOUNT_NUMBER') if rows else '1000000101')
    rec = next((r for r in rows if str(r.get('ACCOUNT_NUMBER')) == str(q)), rows[0] if rows else {})
    lines = _header('ACCT') + [
        _pad('                         ACCOUNT INQUIRY & MAINTENANCE'),
        _pad(''),
        _pad(f' ACCOUNT NUMBER . . {q}'),
        _pad(f' CUSTOMER ID . . . . {rec.get("CUSTOMER_ID", "10000001")}'),
        _pad(f' ACCOUNT TYPE . . . {rec.get("ACCOUNT_TYPE", rec.get("TYPE", "DDA"))}'),
        _pad(f' ACTUAL BALANCE . . {rec.get("ACTUAL_BALANCE", rec.get("BALANCE", "0.00"))}'),
        _pad(f' AVAILABLE BAL . . . {rec.get("AVAILABLE_BALANCE", rec.get("BALANCE", "0.00"))}'),
        _pad(f' STATUS . . . . . . . {rec.get("STATUS", "ACTIVE")}'),
        _pad(''),
        _pad(' ACTIONS: INQ ADD UPD DEL CREDIT DEBIT TRANSFER'),
        _pad(' DB2 TABLE: FIBS.ACCOUNT / CICS PROGRAM: FIBSACCT'),
    ]
    return _screen('ACCT', 'ACCOUNT INQUIRY & MAINTENANCE', lines, [
        _field('account', 'ACCOUNT NUMBER', 5, 24, 14, q, numeric=True),
        _field('acct_customer', 'CUSTOMER ID', 6, 24, 12, rec.get('CUSTOMER_ID', '')),
        _field('balance', 'BALANCE', 8, 24, 14, rec.get('ACTUAL_BALANCE', rec.get('BALANCE', '0.00')), numeric=True),
        _field('acct_action', 'ACTION', 15, 10, 8, 'INQ'),
    ], sess.message)


def _transaction_screen(state: Any, sess: FibsCicsSession) -> dict[str, Any]:
    tx_rows = _sql_rows(state, "SELECT * FROM FIBS.PROCTRAN", sess.userid or 'IBMUSER')
    last_tx = tx_rows[-1] if tx_rows else {}
    lines = _header('TRAN') + [
        _pad('                         TRANSACTION POSTING'), '',
        _pad(' FROM ACCOUNT . . . 1000000101'),
        _pad(' TO ACCOUNT . . . . 1000000201'),
        _pad(' AMOUNT . . . . . . 00000100.00'),
        _pad(' REFERENCE . . . . . TRAINING TRANSFER'),
        _pad(' APPROVAL FLAG . . . N'), '',
        _pad(' CICS PROGRAM: FIBSTRAN  DB2 TABLE: FIBS.TRANSACTION'),
        _pad(' TRAINING: HIDDEN AUTHFLAG / APPROVAL-FLAG CAN BE INSPECTED BY HACK3270'),
    ]
    return _screen('TRAN', 'TRANSACTION POSTING', lines, [
        _field('from_account', 'FROM ACCOUNT', 5, 24, 14, '1000000101', numeric=True),
        _field('to_account', 'TO ACCOUNT', 6, 24, 14, '1000000201', numeric=True),
        _field('amount', 'AMOUNT', 7, 24, 14, '00000100.00', numeric=True),
        _field('AUTHFLAG', 'AUTHFLAG', 18, 2, 1, 'N', protected=True, hidden=True),
    ], sess.message)


def _bulk_screen(state: Any, sess: FibsCicsSession) -> dict[str, Any]:
    batch_rows = _sql_rows(state, "SELECT * FROM FIBS.BATCH_TRANSFER", sess.userid or 'IBMUSER')
    batch = batch_rows[0] if batch_rows else {}
    lines = _header('BULK') + [
        _pad('                         BULK PROCESSING CENTRE'), '',
        _pad(f' BATCH ID . . . . . {batch.get("BATCH_ID", "B2026A17")}'),
        _pad(f' ITEM COUNT . . . . {batch.get("ITEM_COUNT", "00012")}'),
        _pad(f' TOTAL VALUE . . .  {batch.get("TOTAL_VALUE", "000245000.00")}'),
        _pad(f' STATUS . . . . . . {batch.get("STATUS", "HELD-PIN-REQ")}'),
        _pad(' SUPERVISOR ID . . SUPR01'),
        _pad(' RELEASE PIN . . . ____'), '',
        _pad(' CICS PROGRAM: FIBSBULK  DB2 TABLE: FIBS.PAYMENT_BATCH'),
        _pad(' TRAINING PIN FOR CONTROLLED LAB: 0032'),
    ]
    return _screen('BULK', 'BULK PROCESSING CENTRE', lines, [
        _field('batch_id', 'BATCH ID', 5, 24, 12, 'B2026A17'),
        _field('release_pin', 'RELEASE PIN', 10, 24, 4, '', numeric=True),
        _field('PIN_HASH', 'PIN_HASH', 18, 2, 16, 'SIMULATED', protected=True, hidden=True),
    ], sess.message)


def _rest_screen(state: Any, sess: FibsCicsSession) -> dict[str, Any]:
    _db2_audit(state, sess, 'REST', 'REST security tester opened')
    Db2Simulator(state).run_sql("INSERT INTO FIBS.API_AUDIT (ACTION,RESULT,RESOURCE,DETAILS) VALUES ('OPEN','OK','FIBS.REST','REST tester opened')", sess.userid or 'IBMUSER')
    _sql_rows(state, "SELECT * FROM FIBS.API_AUDIT", sess.userid or 'IBMUSER')
    lines = _header('REST') + [
        _pad('                         REST API SECURITY TESTER'), '',
        _pad(' 1 CUSTOMER API LOOKUP        /api/v1/fibs/customers/{id}'),
        _pad(' 2 ACCOUNT API LOOKUP         /api/v1/fibs/accounts/{id}'),
        _pad(' 3 UNSAFE QUERY TEST          /api/v1/ui8999/api-menu/unsafe-query'),
        _pad(' 4 DB2 RAW QUERY LAB          /api/v1/ui8999/db2/query'), '',
        _pad(" SAMPLE SQLI INPUT: ' OR '1'='1"),
        _pad(' TRAINING MODE ONLY - RESULTS ARE AUDITED'),
    ]
    return _screen('REST', 'REST API SECURITY TESTER', lines, [
        _field('api_option', 'OPTION', 5, 24, 1, '3', numeric=True),
        _field('api_input', 'API INPUT', 12, 24, 30, "' OR '1'='1"),
    ], sess.message)


