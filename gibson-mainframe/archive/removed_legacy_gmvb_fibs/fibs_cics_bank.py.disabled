def route_screen(state: Any, sess: FibsCicsSession, command: str = '',
                 fields: dict[str, Any] | None = None) -> dict[str, Any]:
    fields = {str(k): '' if v is None else str(v) for k, v in (fields or {}).items()}
    sess.fields.update(fields)
    cmd = (command or fields.get('selection') or '').strip().upper()
    if not sess.authenticated:
        return logon_screen(sess)
    aliases = {
        '': sess.screen or 'MENU', 'MENU': 'MENU', 'FIBS': 'MENU', 'GMVB': 'MENU',
        '1': 'CUST', 'CUST': 'CUST',
        '2': 'ACCT', 'ACCT': 'ACCT',
        '3': 'TRAN', 'TRAN': 'TRAN',
        '4': 'BULK', 'BULK': 'BULK', 'BATCH': 'BULK',
        '5': 'LOGO', 'LOGO': 'LOGO', 'CESF': 'LOGO',
        '6': 'REST', 'REST': 'REST', 'APIM': 'REST',
        '7': 'TN32', 'TN32': 'TN32',
        '8': 'CICS', 'CICS': 'CICS',
        '9': 'BLAB', 'BLAB': 'BLAB',
        'DVCA': 'DVCA', 'CECI': 'CECI', 'CEMT': 'CEMT',
        'PF3': 'MENU', 'F3': 'MENU', 'PF12': 'MENU', 'F12': 'MENU',
    }
    target = aliases.get(cmd.split()[0] if cmd else '', cmd.split()[0] if cmd else sess.screen)
    # Db2-backed actions.  These mutate FIBS tables through Db2Simulator so
    # CICS, port 8999, DB2 RUN SQL and SPUFI see the same state.
    if target == 'TRAN' and fields.get('amount'):
        amt = fields.get('amount', '0.00')
        acct = fields.get('from_account') or fields.get('account') or '1000000101'
        to_acct = fields.get('to_account') or ''
        Db2Simulator(state).run_sql(
            "INSERT INTO FIBS.PROCTRAN "
            "(ACCOUNT_NUMBER,RELATED_ACCOUNT,TRANSACTION_TYPE,AMOUNT,DESCRIPTION,SOURCE,STATUS) "
            f"VALUES ('{acct}','{to_acct}','DEB','{amt}','CICS FIBS POST','CICS','POSTED')",
            sess.userid or 'IBMUSER')
        _db2_audit(state, sess, 'TRAN', f'Transaction posted for {acct}')
        sess.message = 'DFHAC0001 TRANSACTION POSTED THROUGH DB2'
    if target == 'BULK' and fields.get('release_pin'):
        bid = fields.get('batch_id') or 'B2026A17'
        status = 'RELEASED' if fields.get('release_pin') == '0032' else 'HELD-PIN-REQ'
        Db2Simulator(state).run_sql(
            f"UPDATE FIBS.BATCH_TRANSFER SET STATUS='{status}' WHERE BATCH_ID='{bid}'",
            sess.userid or 'IBMUSER')
        _db2_audit(state, sess, 'BULK', f'Batch {bid} status {status}')
        sess.message = f'DFHBA7701 BATCH {bid} {status}'

    if target == 'LOGO':
        sess.authenticated = False
        sess.message = f'SIGNOFF COMPLETE - {sess.userid}'
        sess.userid = ''
        sess.screen = 'LOGON'
        return logon_screen(sess)
    sess.screen = target
    sess.audit.append({'ts': datetime.now().isoformat(), 'userid': sess.userid, 'command': cmd, 'target': target})
    _db2_audit(state, sess, target, f'Command {cmd or target} routed to {target}')
    if target == 'MENU': return menu_screen(sess)
    if target == 'CUST': return _customer_screen(state, sess, fields.get('customer_id') or (cmd.split()[1] if len(cmd.split()) > 1 else ''))
    if target == 'ACCT': return _account_screen(state, sess, fields.get('account') or (cmd.split()[1] if len(cmd.split()) > 1 else ''))
    if target == 'TRAN': return _transaction_screen(state, sess)
    if target == 'BULK': return _bulk_screen(state, sess)
    if target == 'REST': return _rest_screen(state, sess)
    if target == 'TN32': return _tn32_screen(state, sess)
    if target == 'CICS': return _cics_services_screen(sess)
    if target == 'BLAB': return _blab_screen(sess)
    if target == 'DVCA': return _dvca_screen(state, sess)
    if target == 'CECI': return _ceci_screen(sess)
    if target == 'CEMT': return _cemt_screen(sess)
    sess.message = f'TRANSACTION {target} NOT IMPLEMENTED'
    return menu_screen(sess)


def authenticate(state: Any, sess: FibsCicsSession, userid: str, password: str) -> tuple[bool, str]:
    userid_u = (userid or '').strip().upper()
    password_s = password or ''
    ok = False
    try:
        ok = bool(state.racf.verify_password(userid_u, password_s))
    except Exception:
        ok = False
    if ok:
        sess.userid = userid_u
        sess.authenticated = True
        sess.screen = 'MENU'
        sess.message = f'SIGNON OK - {userid_u}'
        try:
            state.audit.record(userid_u, 'FIBS SIGNON', 'ENTER', 'CICS')
        except Exception:
            pass
        _db2_audit(state, sess, 'SIGNON', f'FIBS signon for {userid_u}')
        return True, sess.message
    sess.userid = userid_u
    sess.authenticated = False
    sess.screen = 'LOGON'
    sess.message = 'SIGNON FAILED - GACF USERID/PASSWORD NOT ACCEPTED'
    return False, sess.message


def to_response(state: Any, sess: FibsCicsSession, screen: dict[str, Any]) -> dict[str, Any]:
    return {
        'sid': sess.sid,
        'userid': sess.userid,
        'authenticated': sess.authenticated,
        'operator': sess.userid,
        'terminal': sess.terminal,
        'region': sess.region,
        'application': 'FIBS CICS App - BANKMASTER/VS',
        'screen': screen,
        'screen_name': screen.get('name'),
        'fields': screen.get('fields', []),
        'lines': screen.get('lines', []),
        'messages': [screen.get('message')] if screen.get('message') else [],
        'backend': {
            'cics_transaction': 'FIBS',
            'cobol_program': f'FIBS{screen.get("name", "MENU")}',
            'db2_schema': 'FIBS',
            'gacf': True,
            'port': 8999,
        },
    }


def screen_to_text(screen: dict[str, Any]) -> str:
    return '\n'.join(str(x) for x in screen.get('lines', []))


def html_escape_screen(screen: dict[str, Any]) -> str:
    return html.escape(screen_to_text(screen))

# ---------------------------------------------------------------------------
# DVCA / CICSLAB1 full training implementation for port 8999 and L CICS FIBS.
# Appended deliberately so the current package keeps earlier BANKMASTER paths
# while these richer screens override placeholder DVCA/BLAB behaviour.
# ---------------------------------------------------------------------------

_DVCA_SCREENS = {'MCGM', 'MCMM', 'MCOR', 'MCAD', 'MCHI', 'SCRT'}


def _sql_quote(value: Any) -> str:
    return str(value if value is not None else '').replace("'", "''")


def _insert_audit(state: Any, userid: str, event_type: str, action: str,
                  details: str, *, resource: str = 'DVCA', source: str = 'dvca') -> None:
    sql = (
        "INSERT INTO FIBS.AUDITLOG "
        "(EVENT_TYPE,ACTION,RESULT,RESOURCE,DETAILS,SOURCE) VALUES "
        f"('{_sql_quote(event_type)}','{_sql_quote(action)}','OK',"
        f"'{_sql_quote(resource)}','{_sql_quote(details)}','{_sql_quote(source)}')"
    )
    try:
        Db2Simulator(state).run_sql(sql, userid or 'IBMUSER')
    except Exception:
        pass


def _insert_hack_event(state: Any, sess: FibsCicsSession, action: str,
                       details: str, *, result: str = 'OK') -> None:
    sql = (
        "INSERT INTO FIBS.HACK3270_EVENT "
        "(EVENT_TYPE,ACTION,RESULT,DETAILS) VALUES "
        f"('HACK3270','{_sql_quote(action)}','{_sql_quote(result)}',"
        f"'{_sql_quote(details)}')"
    )
    try:
        Db2Simulator(state).run_sql(sql, sess.userid or 'IBMUSER')
    except Exception:
        pass
    _insert_audit(state, sess.userid or 'IBMUSER', 'DVCA', action, details,
                  resource='FIBS.HACK3270_EVENT', source='dvca')


def _insert_api_audit(state: Any, sess: FibsCicsSession, action: str,
                      details: str, *, resource: str = 'FIBS.API_AUDIT') -> None:
    sql = (
        "INSERT INTO FIBS.API_AUDIT "
        "(ACTION,RESULT,RESOURCE,DETAILS) VALUES "
        f"('{_sql_quote(action)}','OK','{_sql_quote(resource)}',"
        f"'{_sql_quote(details)}')"
    )
    try:
        Db2Simulator(state).run_sql(sql, sess.userid or 'IBMUSER')
    except Exception:
        pass
    _insert_audit(state, sess.userid or 'IBMUSER', 'API', action, details,
                  resource=resource, source='api')


def _insert_tn3270_capture(state: Any, sess: FibsCicsSession, excerpt: str) -> None:
    sql = (
        "INSERT INTO FIBS.TN3270_CAPTURE "
        "(CAPTURE_ID,SESSION,USERID,TRANSID,BUFFER_EXCERPT) VALUES "
        f"('CAP-DVCA','{_sql_quote(sess.sid)}','{_sql_quote(sess.userid)}',"
        f"'{_sql_quote(sess.screen)}','{_sql_quote(excerpt)}')"
    )
    try:
        Db2Simulator(state).run_sql(sql, sess.userid or 'IBMUSER')
    except Exception:
        pass


def _hack_state(sess: FibsCicsSession) -> dict[str, Any]:
    state = sess.fields.setdefault('_hack3270', {})
    if not isinstance(state, dict):
        state = {}
        sess.fields['_hack3270'] = state
    defaults = {
        'master': False,
        'disable_field_protection': False,
        'enable_hidden_fields': False,
        'remove_numeric_only': False,
        'start_field': False,
        'start_field_extended': False,
        'modify_field': False,
        'inject_cust_id': False,
        'inject_acct_no': False,
        'inject_pin': False,
        'inject_enter': False,
        'inject_pf3': False,
        'inject_clear': False,
        'batch_pin_enabled': False,
        'pins_attempted': 0,
        'pins_found': 0,
        'hidden_exposed': 0,
        'protected_overtyped': 0,
        'api_intercepted': 0,
        'fields_injected': 0,
        'screens': 0,
    }
    for k, v in defaults.items():
        state.setdefault(k, v)
    return state


def _dvca_toolbar_lines(sess: FibsCicsSession) -> list[str]:
    h = _hack_state(sess)
    on = 'ON ' if h.get('master') else 'OFF'
    return [
        _pad('hack3270-glbson v1.0'),
        _pad('Hack Field Attributes | Inject Info Fields | Inject Key Presses | BATCH PIN | API Leakage | Logs | Statistics | Help'),
        _pad(f'Hack Fields: {on}  [ ] Disable Field Protection  [ ] Enable Hidden Fields  [ ] Remove Numeric Only Restrictions'),
        _pad(' [ ] Start Field   [ ] Start Field Extended   [ ] Modify Field'),
        _pad(f'x3270-gibson 127.0.0.1:9999 — {sess.screen or "MCGM"}'),
    ]


def _dvca_status_line(sess: FibsCicsSession, trans: str) -> str:
    h = _hack_state(sess)
    suffix = '  HACK3270 ON' if h.get('master') else ''
    return _pad(f'TRANS: {trans:<8} OPER: {sess.userid or "DVCA":<8} REGION: CICSREG1  DVCA - DAMN VULNERABLE CICS APPLICATION - PIB{suffix}')


def _dvca_mcgm_screen(state: Any, sess: FibsCicsSession) -> dict[str, Any]:
    sess.screen = 'MCGM'
    _insert_hack_event(state, sess, 'OPEN', 'DVCA MCGM opened')
    _insert_tn3270_capture(state, sess, 'TRAN=MCGM FIELD=PA3 ATTR=AID PROT=N')
    lines = _dvca_toolbar_lines(sess) + [
        _pad('MCGM'),
        _pad(''),
        _pad('         __  __      _     ____'),
        _pad('        |  \/  | ___| |   / ___|__ _ _ __ __ _  ___'),
        _pad("        | |\/| |/ _ \\ |  | |   / _` | '__/ _` |/ _ \\"),
        _pad('        | |  | |  __/ |  | |__| (_| | | | (_| | (_) |'),
        _pad('        |_|  |_|\\___|_|   \\____\\__,_|_|  \\__, |\\___/'),
        _pad('                                          |___/'),
        _pad('         ================================================'),
        _pad('         |   DAMN VULNERABLE CICS APPLICATION (DVCA)   |'),
        _pad("         |      Mel's Cargo - Office Supply Store       |"),
        _pad('         ================================================'),
        _pad(''),
        _pad('                   Transaction: MCGM'),
        _pad(''),
        _pad('         PF1  - Help         PF3  - Quit'),
        _pad('         PF5  - Main Menu    PA3  - Secret'),
        _pad("         PRESS PF5 TO ENTER MEL'S CARGO MAIN MENU"),
        _pad(''),
        _pad('PF5 - MAIN MENU     PF1 - HELP     PF3 - QUIT'),
        _pad('PA3 IS NOT A STANDARD KEYBOARD KEY — USE HACK3270 TO INJECT AID'),
        _dvca_status_line(sess, 'DVCA'),
    ]
    return _screen('MCGM', "Mel's Cargo DVCA", lines, [], sess.message)


def _dvca_mcmm_screen(state: Any, sess: FibsCicsSession) -> dict[str, Any]:
    sess.screen = 'MCMM'
    _insert_hack_event(state, sess, 'NAVIGATE', 'DVCA MCMM main menu opened')
    lines = _dvca_toolbar_lines(sess) + [
        _pad('MCMM'), _pad(''),
        _pad("                  MEL'S CARGO - MAIN MENU"),
        _pad('                  ------------------------'), _pad(''),
        _pad(' 1  MCOR - OFFICE SUPPLIES PRICE LIST / ORDER ENTRY'),
        _pad(' 2  MCAD - SHIPPING ADDRESS AND SUPERVISOR PIN'),
        _pad(' 3  MCHI - ORDER HISTORY'),
        _pad('99  HIDDEN DELETE HISTORY OPTION (TRAINING VULN)'),
        _pad(''),
        _pad('Protected and hidden BMS fields can be inspected with hack3270.'),
        _dvca_status_line(sess, 'MCMM'),
    ]
    return _screen('MCMM', "Mel's Cargo Main Menu", lines, [_field('selection', 'OPTION', 10, 20, 2, '1')], sess.message)


def _dvca_mcor_screen(state: Any, sess: FibsCicsSession) -> dict[str, Any]:
    sess.screen = 'MCOR'
    _insert_hack_event(state, sess, 'NAVIGATE', 'DVCA MCOR order screen opened')
    h = _hack_state(sess)
    hidden = 'Y' if h.get('enable_hidden_fields') else 'N'
    lines = _dvca_toolbar_lines(sess) + [
        _pad('MCOR'), _pad(''),
        _pad("                  MEL'S CARGO - OFFICE SUPPLY ORDER"),
        _pad(' ITEM     DESCRIPTION             PRICE     PURCHASABLE'),
        _pad(' P001     TONER CARTRIDGE          89.95     Y'),
        _pad(' P002     MAINFRAME GREEN BAR      19.95     Y'),
        _pad(' P999     RESTRICTED COURIER KEY   00.01     N  <hidden if HACK OFF>'),
        _pad(''),
        _pad(f'HIDDEN FIELD VISIBILITY: {hidden}'),
        _pad('VULN: FSET/protected PRICE and PURCHASABLE fields can be modified in training mode.'),
        _dvca_status_line(sess, 'MCOR'),
    ]
    return _screen('MCOR', 'MCOR Order Entry', lines, [
        _field('item', 'ITEM', 4, 2, 4, 'P001'),
        _field('price', 'PRICE', 4, 38, 8, '89.95', protected=True, numeric=True),
        _field('purchasable', 'PURCHASABLE', 4, 50, 1, 'Y', hidden=True),
    ], sess.message)


