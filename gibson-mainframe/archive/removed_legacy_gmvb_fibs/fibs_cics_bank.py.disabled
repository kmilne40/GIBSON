from __future__ import annotations

from dataclasses import dataclass, field
from datetime import datetime
from typing import Any
import html

from gibson.apps.db2_sim import Db2Simulator


def _today() -> str:
    return datetime.now().strftime('%d/%m/%y')


def _now() -> str:
    return datetime.now().strftime('%H:%M:%S')


@dataclass
class FibsCicsSession:
    sid: str
    userid: str = ''
    authenticated: bool = False
    screen: str = 'LOGON'
    message: str = 'ENTER OPERATOR ID AND PASSWORD THEN PRESS ENTER'
    terminal: str = 'LT0042'
    region: str = 'CICSREG1'
    fields: dict[str, str] = field(default_factory=dict)
    audit: list[dict[str, Any]] = field(default_factory=list)


_SESSIONS: dict[str, FibsCicsSession] = {}


def get_fibs_cics_session(sid: str = 'UI8999') -> FibsCicsSession:
    sid = str(sid or 'UI8999')
    sess = _SESSIONS.get(sid)
    if sess is None:
        sess = FibsCicsSession(sid=sid)
        _SESSIONS[sid] = sess
    return sess


def reset_fibs_cics_session(sid: str = 'UI8999') -> FibsCicsSession:
    sid = str(sid or 'UI8999')
    sess = FibsCicsSession(sid=sid)
    _SESSIONS[sid] = sess
    return sess


def _field(name: str, label: str, row: int, col: int, length: int,
           value: str = '', *, protected: bool = False,
           hidden: bool = False, numeric: bool = False) -> dict[str, Any]:
    return {
        'id': name,
        'name': name,
        'label': label,
        'row': row,
        'col': col,
        'length': length,
        'value': '' if value is None else str(value),
        'protected': protected,
        'hidden': hidden,
        'numeric': numeric,
    }


def _text(row: int, col: int, text: str, color: str = 'green') -> dict[str, Any]:
    return {'row': row, 'col': col, 'text': str(text), 'color': color}


def _screen(name: str, title: str, lines: list[str], fields: list[dict[str, Any]],
            message: str = '') -> dict[str, Any]:
    return {
        'name': name,
        'title': title,
        'lines': lines,
        'texts': [_text(i + 1, 1, line) for i, line in enumerate(lines[:24])],
        'fields': fields,
        'message': message,
        'date': _today(),
    }


def _pad(line: str = '') -> str:
    return line[:132]


def _header(trans: str = 'BKGMENU') -> list[str]:
    return [
        _pad(f'BANKMASTER/VS {trans:<8} DATE: {_today()}'),
        _pad('-' * 79),
    ]


def logon_screen(sess: FibsCicsSession) -> dict[str, Any]:
    lines = [
        _pad('                         BANKMASTER/VS - IBM CICS/VS 2.1.1 - SYSID: PROD'),
        _pad('                         ----------------------------------------------------'),
        _pad(''), _pad(''), _pad(''),
        _pad('                                   S I G H B E R B A N K   P L C'),
        _pad('                              CUSTOMER INFORMATION CONTROL SYSTEM'),
        _pad(f'                           MAINFRAME BANKING APPLICATION - TERMINAL: {sess.terminal}'),
        _pad('                           ------------------------------------------------'),
        _pad(''), _pad(''),
        _pad('                                  OPERATOR ID :       ________'),
        _pad(''),
        _pad('                                  PASSWORD :       ________'),
        _pad(''), _pad(''),
        _pad('                           ENTER OPERATOR ID AND PASSWORD THEN PRESS ENTER'),
        _pad(''), _pad(''),
        _pad('                        AUTHORISED ACCESS ONLY - ALL SESSIONS ARE LOGGED AND MONITORED'),
        _pad('                  UNAUTHORISED ACCESS IS A CRIMINAL OFFENCE UNDER THE COMPUTER MISUSE ACT 1984'),
        _pad('                         SYSTEM TRANSACTIONS: CECI CEMT CEDA - NO AUTH REQUIRED'),
        _pad(f'                              DATE: {_today()} SYSTEM: BANKMASTER/VS 3.4 IBM 3083-EX4'),
        _pad(sess.message),
    ]
    return _screen('LOGON', 'BANKMASTER/VS LOGON', lines, [
        _field('userid', 'OPERATOR ID', 12, 54, 8, sess.userid),
        _field('password', 'PASSWORD', 14, 54, 8, '', protected=False),
    ], sess.message)


