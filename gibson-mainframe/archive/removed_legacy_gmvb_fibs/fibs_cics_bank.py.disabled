    # Backend state/audit is written in route_screen where state is available.
    lines = _header('CICSLAB1') + [
        _pad('                         BANKING LAB - CICSLAB1'),
        _pad(''),
        _pad('                 S I G H B E R B A N K   P L C'),
        _pad('            BANKING LAB - CICS/VS APPLID: CICSLAB1'),
        _pad(f' DATE: {_today()}  · TN3270 PORT: 23 · TERMINAL: {sess.terminal}'),
        _pad(''),
        _pad('  ⚠ AUTHORISED USE ONLY · ALL SESSIONS ARE MONITORED AND LOGGED · DFHCE3520'),
        _pad(''),
        _pad(' USERID  ==> ________'),
        _pad(' PASSWORD ==> ________'),
        _pad(' [ ENTER - LOGON ]'),
        _pad(''),
        _pad(' DEFAULT CREDENTIALS (VULN #2 HARDCODED): IBMUSER / SYS1'),
        _pad(' OTHER ACCOUNTS: CICSUSER / CICS · ADMIN / ADMIN · TEST / TEST'),
        _pad(''),
        _pad(' LAB GUIDE | HACK PANEL ⚠ | TN3270 PACKETS | TN3270 EXPLOIT'),
        _pad(' LAB OVERVIEW | VULNERABILITY INDEX | LAB EXERCISES | REMEDIATION GUIDE'),
        _pad(''),
        _pad(' WHAT IS THIS LAB?'),
        _pad(' This Banking Lab simulates a 1980s-era IBM CICS/VS mainframe banking system running BankMaster/VS.'),
        _pad(' Objectives: auth weaknesses, unauthenticated admin panel, TN3270 packet streams, CECI/CEMT, SQL injection.'),
        _pad(''),
        _pad(' REST API VULNERABILITY TESTER: endpoint selector | method selector | request body | SEND | response viewer'),
        _pad(" Default SQLi payload: ' OR '1'='1   writes FIBS.API_AUDIT and FIBS.AUDITLOG"),
        _pad(''),
        _pad('PF3 MAIN MENU   PF12 LAB EXIT              HACK3270 ON'),
        _pad('TRANS: BLAB     OPER: DVCA                 BANKING LAB - CICSLAB1 - INTERACTIVE VULNERABILITY SIMULATION'),
    ]
    return _screen('BLAB', 'BANKING LAB - CICSLAB1', lines, [
        _field('lab_userid', 'USERID', 9, 14, 8, 'IBMUSER'),
        _field('lab_password', 'PASSWORD', 10, 14, 8, ''),
        _field('rest_endpoint', 'ENDPOINT', 23, 3, 42, '/api/v1/ui8999/api-menu/unsafe-query'),
        _field('rest_method', 'METHOD', 23, 48, 6, 'POST'),
        _field('rest_body', 'REQUEST BODY', 24, 3, 70, "{\"query\":\"' OR '1'='1\"}"),
    ], sess.message)


def _route_dvca_action(state: Any, sess: FibsCicsSession, target: str, fields: dict[str, str]) -> dict[str, Any] | None:
    h = _hack_state(sess)
    t = target.upper()
    if t in {'HACK', 'HACKON', 'HACK3270', 'HACK_ON'}:
        h['master'] = True
        _insert_hack_event(state, sess, 'HACK3270_ON', 'hack3270 master enabled')
        sess.message = 'HACK3270 ON - FIELD ATTRIBUTE OVERRIDE ENABLED'
        return _dvca_mcgm_screen(state, sess) if sess.screen not in _DVCA_SCREENS else _dvca_screen_by_name(state, sess, sess.screen)
    if t in {'HACKOFF', 'HACK_OFF'}:
        h['master'] = False
        _insert_hack_event(state, sess, 'HACK3270_OFF', 'hack3270 master disabled')
        sess.message = 'HACK3270 OFF - NORMAL BMS ATTRIBUTES RESTORED'
        return _dvca_screen_by_name(state, sess, sess.screen if sess.screen in _DVCA_SCREENS else 'MCGM')
    if t in {'HIDDEN', 'ENABLE_HIDDEN'}:
        h['enable_hidden_fields'] = True
        h['hidden_exposed'] = int(h.get('hidden_exposed', 0)) + 1
        _insert_hack_event(state, sess, 'HIDDEN_FIELDS_ENABLED', 'hidden fields exposed')
        sess.message = 'HIDDEN FIELDS ENABLED'
        return _dvca_screen_by_name(state, sess, sess.screen if sess.screen in _DVCA_SCREENS else 'MCOR')
    if t in {'DISABLE_PROTECTION', 'PROTECT_OFF', 'FSET'}:
        h['disable_field_protection'] = True
        _insert_hack_event(state, sess, 'FIELD_PROTECTION_DISABLED', 'field protection disabled')
        sess.message = 'FIELD PROTECTION DISABLED'
        return _dvca_screen_by_name(state, sess, sess.screen if sess.screen in _DVCA_SCREENS else 'MCOR')
    if t in {'NUMERIC_OFF', 'REMOVE_NUMERIC_ONLY'}:
        h['remove_numeric_only'] = True
        _insert_hack_event(state, sess, 'NUMERIC_ONLY_REMOVED', 'numeric-only restriction removed')
        sess.message = 'NUMERIC-ONLY RESTRICTION REMOVED'
        return _dvca_screen_by_name(state, sess, sess.screen if sess.screen in _DVCA_SCREENS else 'MCAD')
    if t in {'INJECT_PRICE', 'INJECT_PURCHASABLE', 'MODIFY_FIELD'}:
        h['fields_injected'] = int(h.get('fields_injected', 0)) + 1
        h['protected_overtyped'] = int(h.get('protected_overtyped', 0)) + 1
        _insert_hack_event(state, sess, 'PROTECTED_FIELD_MODIFIED', 'protected price/purchasable field modified')
        sess.message = 'PROTECTED FIELD MODIFIED IN TRAINING MODE'
        return _dvca_mcor_screen(state, sess)
    if t in {'PINBRUTE', 'BATCHPIN', 'BATCH_PIN'}:
        h['batch_pin_enabled'] = True
        h['pins_attempted'] = 1338
        h['pins_found'] = 1
        _insert_hack_event(state, sess, 'PIN_BRUTE_FORCE_STARTED', 'batch PIN brute force started')
        _insert_hack_event(state, sess, 'PIN_FOUND', 'supervisor PIN 1337 found')
        sess.message = 'BATCH PIN COMPLETE - SUPERVISOR PIN 1337 FOUND'
        return _dvca_mcad_screen(state, sess)
    if t in {'PA3', 'AID_PA3', 'SECRET'}:
        if h.get('master'):
            _insert_hack_event(state, sess, 'PA3_INJECTED', 'PA3 AID injected')
            sess.message = 'PA3 INJECTED - SECRET SCREEN REACHED'
            return _dvca_scrt_screen(state, sess)
        sess.message = 'PA3 REJECTED - ENABLE HACK3270 MASTER FIRST'
        _insert_hack_event(state, sess, 'PA3_REJECTED', 'PA3 rejected because hack3270 master is off', result='REJECTED')
        return _dvca_mcgm_screen(state, sess)
    if t in {'APILEAK', 'API_LEAK', 'RESTTEST', 'SQLI'}:
        h['api_intercepted'] = int(h.get('api_intercepted', 0)) + 1
        _insert_api_audit(state, sess, 'REST_VULN_TEST', "unsafe-query payload ' OR '1'='1 executed from lab panel")
        _insert_hack_event(state, sess, 'API_LEAK_OBSERVED', 'API leak/intercept observed in DVCA toolbar')
        sess.message = "API LEAK OBSERVED - ROWS RETURNED=8 ENDPOINT=/api/v1/ui8999/api-menu/unsafe-query"
        return _blab_screen(sess) if sess.screen == 'BLAB' else _dvca_screen_by_name(state, sess, sess.screen if sess.screen in _DVCA_SCREENS else 'MCGM')
    return None


def _dvca_screen_by_name(state: Any, sess: FibsCicsSession, name: str) -> dict[str, Any]:
    n = (name or 'MCGM').upper()
    _hack_state(sess)['screens'] = int(_hack_state(sess).get('screens', 0)) + 1
    if n == 'MCMM': return _dvca_mcmm_screen(state, sess)
    if n == 'MCOR': return _dvca_mcor_screen(state, sess)
    if n == 'MCAD': return _dvca_mcad_screen(state, sess)
    if n == 'MCHI': return _dvca_mchi_screen(state, sess)
    if n == 'SCRT': return _dvca_scrt_screen(state, sess)
    return _dvca_mcgm_screen(state, sess)


_OLD_RICH_ROUTE_SCREEN = route_screen


def route_screen(state: Any, sess: FibsCicsSession, command: str = '',
                 fields: dict[str, Any] | None = None) -> dict[str, Any]:
    fields = {str(k): '' if v is None else str(v) for k, v in (fields or {}).items()}
    sess.fields.update(fields)
    cmd = (command or fields.get('selection') or '').strip().upper()
    if not sess.authenticated:
        return logon_screen(sess)
    verb = cmd.split()[0] if cmd else ''
    # DVCA navigation/toolbar actions are real backend events and not static UI.
    action_screen = _route_dvca_action(state, sess, verb, fields) if verb else None
    if action_screen is not None:
        return action_screen
    aliases = {
        'DVCA': 'MCGM', 'MCGM': 'MCGM', 'PF5': 'MCMM', 'F5': 'MCMM', 'MCMM': 'MCMM',
        '1': 'MCOR' if sess.screen == 'MCMM' else 'CUST', 'MCOR': 'MCOR',
        '2': 'MCAD' if sess.screen == 'MCMM' else 'ACCT', 'MCAD': 'MCAD',
        '3': 'MCHI' if sess.screen == 'MCMM' else 'TRAN', 'MCHI': 'MCHI',
        'SCRT': 'SCRT', 'BLAB': 'BLAB', 'RESTTEST': 'RESTTEST', 'SQLI': 'SQLI',
    }
    if verb in aliases and aliases[verb] in _DVCA_SCREENS:
        return _dvca_screen_by_name(state, sess, aliases[verb])
    if verb == 'BLAB':
        sess.screen = 'BLAB'
        _insert_audit(state, sess.userid or 'IBMUSER', 'BLAB', 'OPEN', 'CICSLAB1 Banking Lab opened', resource='CICSLAB1', source='blab')
        _insert_api_audit(state, sess, 'LAB_OPEN', 'CICSLAB1 REST tester initialized')
        return _blab_screen(sess)
    if verb in {'RESTTEST', 'SQLI'}:
        return _route_dvca_action(state, sess, 'RESTTEST', fields) or _blab_screen(sess)
    # While inside DVCA, PF3/F3 returns to Mel's menu and PF12 returns to BANKMASTER menu.
    if verb in {'PF3', 'F3'} and sess.screen in _DVCA_SCREENS:
        return _dvca_mcmm_screen(state, sess)
    if verb in {'PF12', 'F12'}:
        sess.screen = 'MENU'
        return menu_screen(sess)
    return _OLD_RICH_ROUTE_SCREEN(state, sess, command, fields)


_OLD_RICH_TO_RESPONSE = to_response


def to_response(state: Any, sess: FibsCicsSession, screen: dict[str, Any]) -> dict[str, Any]:
    base = _OLD_RICH_TO_RESPONSE(state, sess, screen)
    h = _hack_state(sess)
    base['hack3270'] = {
        'toolbar': True,
        'master': bool(h.get('master')),
        'disable_field_protection': bool(h.get('disable_field_protection')),
        'enable_hidden_fields': bool(h.get('enable_hidden_fields')),
        'remove_numeric_only': bool(h.get('remove_numeric_only')),
        'batch_pin_enabled': bool(h.get('batch_pin_enabled')),
        'stats': {k: h.get(k, 0) for k in ['screens','hidden_exposed','protected_overtyped','pins_attempted','pins_found','api_intercepted','fields_injected']},
        'tabs': ['Hack Field Attributes','Inject Info Fields','Inject Key Presses','BATCH PIN','API Leakage','Logs','Statistics','Help'],
        'training_only': True,
    }
    name = str(screen.get('name') or '')
    if name in _DVCA_SCREENS:
        base['dvca'] = {'active': True, 'transaction': name, 'application': "Mel's Cargo", 'x3270': 'x3270-gibson 127.0.0.1:9999'}
    if name == 'BLAB':
        base['cicslab1'] = {'active': True, 'applid': 'CICSLAB1', 'rest_tester': True, 'hack_panel': True, 'tn3270_packets': True, 'tn3270_exploit': True}
        base['rest_tester'] = {
            'active': True,
            'endpoints': [
                '/api/v1/ui8999/api-menu/unsafe-query',
                '/api/v1/fibs/customers/10000002',
                '/api/v1/fibs/accounts/1000000201',
                '/api/v1/ui8999/cobol/programs/VULNERABLE-BANK-UPDATE',
                '/api/v1/ui8999/cics/command',
            ],
            'default_payload': "' OR '1'='1",
            'audits_to': 'FIBS.API_AUDIT',
        }
    return base
