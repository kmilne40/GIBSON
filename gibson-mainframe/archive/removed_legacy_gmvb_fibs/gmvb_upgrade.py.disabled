"""Additive GMVB banking application upgrade for Gibson.

This module deliberately extends the existing Sighberbank/GMVB lab without
replacing its legacy APIs.  It keeps Gibson authentication, PassTicket and MFA
integration in the existing classes and adds richer CICS/REST/Db2 training
content on top of the shared BankingLabService state.
"""
from __future__ import annotations

from dataclasses import dataclass
from decimal import Decimal, InvalidOperation
from datetime import datetime
from typing import Any, Dict, List
import html
import json
import re
from gibson.apps import gmvb_hack3270
from gibson.apps.gmvb_service import get_gmvb_service

COBOL_SOURCES: dict[str, str] = {
    "GMVBMENU": """       IDENTIFICATION DIVISION.\n       PROGRAM-ID. GMVBMENU.\n       DATA DIVISION.\n       WORKING-STORAGE SECTION.\n       01  WS-TRANSID        PIC X(4).\n       01  WS-USERID         PIC X(8).\n       PROCEDURE DIVISION.\n           EXEC CICS ASSIGN USERID(WS-USERID) END-EXEC.\n           EXEC CICS RECEIVE MAP('GMVBMNU') END-EXEC.\n           EVALUATE WS-TRANSID\n             WHEN 'CUST' EXEC CICS XCTL PROGRAM('CUSTINQ') END-EXEC\n             WHEN 'ACCT' EXEC CICS XCTL PROGRAM('ACCTINQ') END-EXEC\n             WHEN 'TRAN' EXEC CICS XCTL PROGRAM('TRANPST') END-EXEC\n             WHEN OTHER  EXEC CICS SEND MAP('GMVBMNU') END-EXEC\n           END-EVALUATE.\n           EXEC CICS RETURN END-EXEC.\n""",
    "CUSTINQ": """       IDENTIFICATION DIVISION.\n       PROGRAM-ID. CUSTINQ.\n       DATA DIVISION.\n       WORKING-STORAGE SECTION.\n       01  WS-CUSTOMER-ID    PIC X(32).\n       01  WS-SQL            PIC X(256).\n       EXEC SQL INCLUDE SQLCA END-EXEC.\n       PROCEDURE DIVISION.\n           EXEC CICS RECEIVE MAP('CUSTMAP') INTO(WS-CUSTOMER-ID) END-EXEC.\n      *    TRAINING WEAKNESS: UNSAFE STRING CONCATENATION FOR SQLI LAB.\n           STRING 'SELECT * FROM GMVB.CUSTOMER WHERE CUSTOMER_ID='''\n                  WS-CUSTOMER-ID '''' INTO WS-SQL.\n           EXEC SQL PREPARE S1 FROM :WS-SQL END-EXEC.\n           EXEC SQL EXECUTE S1 END-EXEC.\n           EXEC CICS SEND MAP('CUSTMAP') END-EXEC.\n""",
    "CUSTUPD": """       IDENTIFICATION DIVISION.\n       PROGRAM-ID. CUSTUPD.\n       DATA DIVISION.\n       WORKING-STORAGE SECTION.\n       01  INPUT-BUFFER      PIC X(120).\n       01  CUSTOMER-RECORD.\n           05 CUSTOMER-ID    PIC X(8).\n           05 SURNAME        PIC X(30).\n           05 FORENAME       PIC X(20).\n           05 AUTH-FLAG      PIC X.\n       PROCEDURE DIVISION.\n           EXEC CICS RECEIVE INTO(INPUT-BUFFER) END-EXEC.\n      *    TRAINING WEAKNESS: DIRECT MOVE CAN OVERWRITE ADJACENT FIELDS.\n           MOVE INPUT-BUFFER TO CUSTOMER-RECORD.\n           EXEC CICS RETURN END-EXEC.\n""",
    "ACCTINQ": """       IDENTIFICATION DIVISION.\n       PROGRAM-ID. ACCTINQ.\n       DATA DIVISION.\n       WORKING-STORAGE SECTION.\n       01  WS-ACCOUNT-NO     PIC X(10).\n       EXEC SQL INCLUDE SQLCA END-EXEC.\n       PROCEDURE DIVISION.\n           EXEC CICS RECEIVE MAP('ACCTMAP') INTO(WS-ACCOUNT-NO) END-EXEC.\n           EXEC SQL SELECT BALANCE, STATUS\n              INTO :WS-BALANCE, :WS-STATUS\n              FROM GMVB.ACCOUNT\n              WHERE ACCOUNT_NUMBER = :WS-ACCOUNT-NO\n           END-EXEC.\n           EXEC CICS SEND MAP('ACCTMAP') END-EXEC.\n""",
    "TRANPST": """       IDENTIFICATION DIVISION.\n       PROGRAM-ID. TRANPST.\n       DATA DIVISION.\n       WORKING-STORAGE SECTION.\n       01  WS-FROM-ACCT      PIC X(10).\n       01  WS-TO-ACCT        PIC X(10).\n       01  WS-AMOUNT         PIC S9(9)V99 COMP-3.\n       PROCEDURE DIVISION.\n           EXEC CICS RECEIVE MAP('TRANMAP') END-EXEC.\n      *    TRAINING BRANCH: DORMANT/FROZEN CHECK CAN BE DISABLED IN LAB MODE.\n           EXEC SQL UPDATE GMVB.ACCOUNT\n              SET BALANCE = BALANCE - :WS-AMOUNT\n              WHERE ACCOUNT_NUMBER = :WS-FROM-ACCT\n           END-EXEC.\n           EXEC CICS SYNCPOINT END-EXEC.\n           EXEC CICS RETURN END-EXEC.\n""",
    "BLKPRC": """       IDENTIFICATION DIVISION.\n       PROGRAM-ID. BLKPRC.\n       PROCEDURE DIVISION.\n           EXEC CICS START TRANSID('BULK') END-EXEC.\n           DISPLAY 'BATCPST0001 - INITIALISING BATCH STREAM'.\n           DISPLAY 'BATCPST0004 - RECORDS PROCESSED / 0 REJECTED'.\n           EXEC CICS RETURN END-EXEC.\n""",
    "CARDAUTH": """       IDENTIFICATION DIVISION.\n       PROGRAM-ID. CARDAUTH.\n       DATA DIVISION.\n       WORKING-STORAGE SECTION.\n       01  APP-ID            PIC X(10).\n       01  DECISION          PIC X.\n       PROCEDURE DIVISION.\n           EXEC CICS RECEIVE MAP('CARDMAP') END-EXEC.\n           EVALUATE DECISION\n             WHEN 'A' DISPLAY 'APPLICATION APPROVED'\n             WHEN 'R' DISPLAY 'APPLICATION REFERRED'\n             WHEN 'D' DISPLAY 'APPLICATION DECLINED'\n           END-EVALUATE.\n           EXEC CICS RETURN END-EXEC.\n""",
    "RESTTST": """       IDENTIFICATION DIVISION.\n       PROGRAM-ID. RESTTST.\n       PROCEDURE DIVISION.\n           DISPLAY 'REST API TESTER CALLS GIBSON HTTP ROUTES'.\n           EXEC CICS RETURN END-EXEC.\n""",
    "TN32CAP": """       IDENTIFICATION DIVISION.\n       PROGRAM-ID. TN32CAP.\n       PROCEDURE DIVISION.\n           DISPLAY 'STATIC TN3270 PACKET CAPTURE VIEWER'.\n           EXEC CICS RETURN END-EXEC.\n""",
    "GMVBAUTH": """       IDENTIFICATION DIVISION.\n       PROGRAM-ID. GMVBAUTH.\n       PROCEDURE DIVISION.\n      *    LIVE AUTHENTICATION IS PROVIDED BY GIBSON GACF/RACF,\n      *    PASSTICKET/PTKGEN AND MFA. NO LOCAL PASSWORD TABLE IS USED.\n           EXEC CICS RETURN END-EXEC.\n""",
}

