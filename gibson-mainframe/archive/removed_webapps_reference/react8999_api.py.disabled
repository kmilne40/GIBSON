def ui_response(data: Any = None, *, ok: bool = True, error: str | None = None,
                source: str = "runtime", notes: list[str] | None = None) -> dict[str, Any]:
    return {"ok": ok, "data": data, "error": error, "source": source, "notes": notes or []}


def _safe(callable_, *args, **kwargs) -> tuple[int, dict[str, Any]]:
    try:
        return callable_(*args, **kwargs)
    except Exception as exc:  # pragma: no cover - defensive HTTP boundary
        return 500, ui_response(ok=False, error=f"{type(exc).__name__}: {exc}", source="runtime")


def _rows_for_table(lab: Any, name: str) -> list[dict[str, Any]]:
    try:
        rows = lab.catalog().get(name.upper(), [])
        return [dict(r) for r in rows]
    except Exception:
        return []


def _db2_schema(lab: Any) -> dict[str, Any]:
    cat = lab.catalog()
    tables = []
    for full, rows in sorted(cat.items()):
        schema, _, table = full.partition('.')
        if schema in {"SYSIBM", "GIBSON", "GMVB"}:
            columns = sorted({k for row in rows for k in row.keys()}) if isinstance(rows, list) else []
            tables.append({"schema": schema, "table": table, "name": full, "columns": columns, "row_count": len(rows) if isinstance(rows, list) else 0})
    return {"schemas": sorted({t["schema"] for t in tables}), "tables": tables}


def _cics_transactions(state: Any) -> list[dict[str, Any]]:
    cics = CicsSimulator(state, "IBMUSER")
    rows = []
    for name, res in sorted(cics.transactions.items()):
        rows.append({
            "name": name,
            "status": res.status,
            "program": res.attr("PROGRAM"),
            "taskdataloc": res.attr("TASKDATALOC"),
            "source": "CicsSimulator.region",
        })
    return rows



VULNERABLE_BANK_UPDATE_COBOL = "\n       IDENTIFICATION DIVISION.\n       PROGRAM-ID. VULNERABLE-BANK-UPDATE.\n       AUTHOR. SECURITY-TRAINER.\n       REMARKS. THIS PROGRAM CONTAINS INTENTIONAL VULNERABILITIES FOR TRAINING.\n\n       ENVIRONMENT DIVISION.\n       DATA DIVISION.\n       WORKING-STORAGE SECTION.\n\n       01  INPUT-DATA.\n           05  USER-INPUT               PIC X(100).\n           05  FILLER REDEFINES USER-INPUT.\n               10  CUSTOMER-ID         PIC X(10).\n               10  ACCOUNT-TYPE        PIC X(2).\n               10  TRANSACTION-AMOUNT  PIC X(12).\n\n       01  SECURITY-CONTROL-FLAGS.\n           05  AUTHENTICATED-FLAG      PIC X VALUE 'N'.\n           05  ADMIN-FLAG              PIC X VALUE 'N'.\n           05  DEBUG-FLAG              PIC X VALUE 'N'.\n\n       01  CUSTOMER-RECORD.\n           05  CUST-NAME               PIC X(30).\n           05  CUST-ADDRESS            PIC X(50).\n           05  CUST-BALANCE            PIC S9(9)V99 COMP-3.\n           05  CUST-PIN                PIC X(4).\n\n       01  TEMP-STORAGE.\n           05  SENSITIVE-TEMP          PIC X(100).\n           05  LOG-BUFFER              PIC X(256).\n\n       01  MESSAGE-AREA.\n           05  MSG-TEXT                PIC X(100).\n           05  MSG-SEVERITY            PIC X(1).\n\n       LINKAGE SECTION.\n       01  DFHCOMMAREA.\n           05  SYSTEM-CONTROL          PIC X(50).\n\n       PROCEDURE DIVISION.\n\n       500-GET-CHANNEL-DATA.\n           EXEC CICS GET CONTAINER('USERDATA')\n                        CHANNEL('BANKCHAN')\n                        INTO(USER-INPUT)\n                        FLENGTH(USER-INPUT-LENGTH)\n                        RESP(RESPONSE-CODE)\n           END-EXEC.\n           IF RESPONSE-CODE = DFHRESP(NORMAL)\n               MOVE USER-INPUT TO CUSTOMER-RECORD\n           END-IF.\n\n       100-GET-INPUT.\n           EXEC CICS RECEIVE MAP('BANKMAP') INTO(USER-INPUT) END-EXEC.\n           MOVE USER-INPUT TO CUSTOMER-RECORD.\n           STRING 'Tx for: ' CUST-NAME ' Amt: ' TRANSACTION-AMOUNT INTO MSG-TEXT.\n           IF CUST-PIN = '9999' OR AUTHENTICATED-FLAG = 'Y'\n               PERFORM 200-PROCESS-TRANSACTION\n           ELSE\n               PERFORM 800-SEND-ERROR\n           END-IF.\n           IF DEBUG-FLAG = 'Y'\n               PERFORM 700-DEBG-DUMP\n           END-IF.\n\n       200-PROCESS-TRANSACTION.\n           COMPUTE CUST-BALANCE = FUNCTION NUMVAL(TRANSACTION-AMOUNT).\n           MOVE CUSTOMER-RECORD TO LOG-BUFFER.\n           EXEC CICS SEND MAP('BANKMAP') FROM(MESSAGE-AREA) END-EXEC.\n\n       700-DEBG-DUMP.\n           DISPLAY 'DEBUG DUMP: ' TEMP-STORAGE.\n\n       800-SEND-ERROR.\n           MOVE 'AUTHENTICATION FAILED' TO MSG-TEXT.\n           EXEC CICS SEND MAP('BANKMAP') FROM(MESSAGE-AREA) END-EXEC.\n"

_TERMINAL_SESSIONS: dict[str, dict[str, Any]] = {}
_BANK_TRANS = ["GMVB", "CUST", "ACCT", "TRAN", "BATCH", "CCAP", "SWFT", "CHAP", "APIM", "TN32", "COBL", "CEMT", "CECI", "CESF", "HELP"]


def _now() -> str:
    return datetime.utcnow().strftime("%H:%M:%S")


def _hack_state(enabled: bool = False) -> dict[str, bool]:
    return {
        "enabled": bool(enabled),
        "hidden_fields_revealed": bool(enabled),
        "disable_protection": bool(enabled),
        "numeric_bypass": bool(enabled),
        "modify_field": bool(enabled),
        "start_field": bool(enabled),
        "start_field_extended": bool(enabled),
        "high_visibility": bool(enabled),
    }


def _normalise_hack(sess: dict[str, Any], enabled: bool) -> dict[str, bool]:
    sess["hack"] = _hack_state(enabled)
    return sess["hack"]


def _new_session(sid: str, user: str = "GUEST") -> dict[str, Any]:
    sess = {
        "sid": sid,
        "userid": user.upper(),
        "logged_on": False,
        "screen": "CESN",
        "hack": _hack_state(False),
        "field_values": {},
        "logs": [],
        "batch_pin": "0032",
        "api_leakage": [],
    }
    _TERMINAL_SESSIONS[sid] = sess
    return sess


def _session(sid: str) -> dict[str, Any]:
    return _TERMINAL_SESSIONS.get(sid) or _new_session(sid)


def _text(row:int, col:int, text:str, color:str="green") -> dict[str, Any]:
    return {"row": row, "col": col, "text": text, "color": color}


def _field(
    fid: str,
    label: str,
    row: int,
    col: int,
    length: int,
    value: str = "",
    *,
    protected: bool = False,
    hidden: bool = False,
    numeric: bool = False,
    editableNormal: bool | None = None,
    editableWhenHack: bool = True,
    source: str = "screen",
    role: str = "input",
    exploitSink: bool = False,
    modified: bool = False,
) -> dict[str, Any]:
    if editableNormal is None:
        editableNormal = not protected
    return {
        "id": fid,
        "label": label,
        "row": row,
        "col": col,
        "length": length,
        "value": str(value),
        "protected": bool(protected),
        "hidden": bool(hidden),
        "numericOnly": bool(numeric),
        "editableNormal": bool(editableNormal),
        "editableWhenHack": bool(editableWhenHack),
        "source": source,
        "role": role,
        "exploitSink": bool(exploitSink),
        "modified": bool(modified),
    }


def _db_field(fid: str, label: str, row: int, col: int, length: int, value: str = "", *, numeric: bool = False, source: str = "GMVB") -> dict[str, Any]:
    return _field(fid, label, row, col, length, value, protected=True, numeric=numeric, editableNormal=False, editableWhenHack=True, source=source, role="db-returned")


def _screen(name: str, title: str, rows: list[dict[str, Any]], fields: list[dict[str, Any]] | None = None, message: str = "") -> dict[str, Any]:
    pf = [{"key":"PF1","label":"HELP"},{"key":"PF3","label":"EXIT"},{"key":"PF5","label":"REFRESH"},{"key":"ENTER","label":"EXECUTE"}]
    return {"name": name, "title": title, "rows": rows, "fields": fields or [], "cursor": {"row": 22, "col": 15}, "pfkeys": pf, "message": message, "commandLine": True}


def _base_hidden(screen: str, sql: str = "") -> list[dict[str, Any]]:
    return [
        _field("AUTHFLAG", "AUTHFLAG", 16, 2, 1, "N", protected=True, hidden=True, editableNormal=False, source="BMS-HIDDEN", role="control-flag"),
        _field("ADMINFLAG", "ADMINFLAG", 16, 18, 1, "N", protected=True, hidden=True, editableNormal=False, source="BMS-HIDDEN", role="control-flag"),
        _field("DEBUGFLAG", "DEBUGFLAG", 16, 36, 1, "N", protected=True, hidden=True, editableNormal=False, source="BMS-HIDDEN", role="control-flag"),
        _field("PROGRAM", "PROGRAM", 17, 2, 12, {"CUST":"CUSTINQ","ACCT":"ACCTINQ","TRAN":"TRANPST","BATCH":"BATCHREL","CCAP":"CCAPPROV","SWFT":"SWIFTPMT","CHAP":"CHAPPMT"}.get(screen,"VULNBANK"), protected=True, hidden=True, editableNormal=False, source="COBOL", role="program"),
        _field("MAPSET", "MAPSET", 17, 24, 10, "BANKMAP", protected=True, hidden=True, editableNormal=False, source="BMS", role="mapset"),
        _field("SQLTRACE", "SQLTRACE", 18, 2, 70, sql, protected=True, hidden=True, editableNormal=False, source="COBOL-DYNAMIC-SQL", role="sql-trace", exploitSink=True),
    ]


def _is_sqli(value: str) -> bool:
    v = value.upper()
    return "'" in v and (" OR " in v or "--" in v or "1'='1" in v or "1=1" in v)


def _sample_customer_rows(lab: Any) -> list[dict[str, Any]]:
    rows = _rows_for_table(lab, "GMVB.CUSTOMER") or _rows_for_table(lab, "GIBSON.CUSTOMERS")
    return rows or [{"CUSTOMER_ID":"100001","NAME":"ALICE EXAMPLE","STATUS":"ACTIVE","ADDRESS":"22 HIGH STREET"},{"CUSTOMER_ID":"100002","NAME":"BOB EXAMPLE","STATUS":"ACTIVE","ADDRESS":"11 BANK ROAD"}]


def _sample_account_rows(lab: Any) -> list[dict[str, Any]]:
    rows = _rows_for_table(lab, "GMVB.ACCOUNT") or _rows_for_table(lab, "GIBSON.ACCOUNTS")
    return rows or [{"ACCOUNT_ID":"10001","CUSTOMER_ID":"100001","BALANCE":"12500.00","STATUS":"ACTIVE"},{"ACCOUNT_ID":"20002","CUSTOMER_ID":"100002","BALANCE":"950000.00","STATUS":"ACTIVE"}]


