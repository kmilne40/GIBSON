from __future__ import annotations

import json
import mimetypes
import threading
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from typing import Any
from urllib.parse import parse_qs, urlparse

from gibson.core.state import GibsonState
from gibson.services.react8999_api import handle_ui8999, ui_response

_SERVERS = []


def _web_root() -> Path:
    return Path(__file__).resolve().parents[1] / "web8999" / "dist"


def _json_bytes(payload: Any) -> bytes:
    return json.dumps(payload, indent=2, sort_keys=True).encode("utf-8")


class React8999Handler(BaseHTTPRequestHandler):
    state: GibsonState

    server_version = "GibsonReact8999/1.0"

    def log_message(self, fmt: str, *args: Any) -> None:  # quiet simulator tests
        return

    def _send(self, status: int, body: bytes, content_type: str) -> None:
        self.send_response(status)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def _read_json(self) -> dict[str, Any]:
        length = int(self.headers.get("Content-Length", "0") or 0)
        if length <= 0:
            return {}
        raw = self.rfile.read(length).decode("utf-8", "replace")
        try:
            obj = json.loads(raw)
            return obj if isinstance(obj, dict) else {"value": obj}
        except json.JSONDecodeError:
            return {"raw": raw}

    def _query(self) -> dict[str, str]:
        parsed = urlparse(self.path)
        return {k: v[-1] if v else "" for k, v in parse_qs(parsed.query).items()}

    def _handle_api(self, method: str) -> None:
        parsed = urlparse(self.path)
        data = self._read_json() if method in {"POST", "PUT", "PATCH"} else {}
        status, payload = handle_ui8999(self.state, parsed.path, method=method, data=data, query=self._query())
        self._send(status, _json_bytes(payload), "application/json; charset=utf-8")

    def _handle_static(self) -> None:
        parsed = urlparse(self.path)
        root = _web_root()
        rel = parsed.path.lstrip("/") or "index.html"
        target = (root / rel).resolve()
        if not str(target).startswith(str(root.resolve())):
            self._send(403, b"Forbidden", "text/plain; charset=utf-8")
            return
        if not target.exists() or target.is_dir():
            target = root / "index.html"
        if not target.exists():
            body = b"Gibson React8999 app has not been built. Run npm run build in gibson/web8999."
            self._send(503, body, "text/plain; charset=utf-8")
            return
        ctype = mimetypes.guess_type(str(target))[0] or "application/octet-stream"
        self._send(200, target.read_bytes(), ctype)

    def do_GET(self) -> None:
        if urlparse(self.path).path.startswith(("/api/v1/ui8999", "/api/v1/gmvb")):
            self._handle_api("GET")
        else:
            self._handle_static()

    def do_POST(self) -> None:
        if urlparse(self.path).path.startswith(("/api/v1/ui8999", "/api/v1/gmvb")):
            self._handle_api("POST")
        else:
            self._send(404, _json_bytes(ui_response(ok=False, error="not found")), "application/json; charset=utf-8")

    def do_PUT(self) -> None:
        if urlparse(self.path).path.startswith(("/api/v1/ui8999", "/api/v1/gmvb")):
            self._handle_api("PUT")
        else:
            self._send(404, _json_bytes(ui_response(ok=False, error="not found")), "application/json; charset=utf-8")

    def do_DELETE(self) -> None:
        if urlparse(self.path).path.startswith(("/api/v1/ui8999", "/api/v1/gmvb")):
            self._handle_api("DELETE")
        else:
            self._send(404, _json_bytes(ui_response(ok=False, error="not found")), "application/json; charset=utf-8")


def create_react8999_server(state: GibsonState, host: str | None = None, port: int | None = None) -> ThreadingHTTPServer:
    bind_host = host or state.config.host
    bind_port = int(port or getattr(state.config, "react8999_port", 8999))
    handler = type("BoundReact8999Handler", (React8999Handler,), {"state": state})
    return ThreadingHTTPServer((bind_host, bind_port), handler)


def serve_react8999(state: GibsonState) -> ThreadingHTTPServer:
    server = create_react8999_server(state)
    thread = threading.Thread(target=server.serve_forever, name="gibson-react8999", daemon=True)
    thread.start()
    _SERVERS.append(server)
    return server
